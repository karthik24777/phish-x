{
  "manifest_version": 3,
  "name": "PHISH-X Link Guard",
  "version": "0.2.0",
  "description": "Checks every link you open. Warns you before a phishing page loads and can inspect it safely in the PHISH-X sandbox.",
  "permissions": ["webNavigation", "tabs", "storage"],
  "host_permissions": ["http://127.0.0.1:8765/*", "http://localhost:8765/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "PHISH-X Link Guard",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
